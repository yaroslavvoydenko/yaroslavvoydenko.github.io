<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Ярослав Войденко | Офіційний персональний сайт</title>

<meta name="description" content="Офіційний сайт Ярослава Войденка — українського автора, студента-медика та дописувача LIGA.net. Біографія, освіта, публікації та професійна діяльність.">
<meta name="author" content="Ярослав Войденко">
<meta name="theme-color" content="#090b10">

<meta property="og:title" content="Ярослав Войденко — офіційний сайт">
<meta property="og:description" content="Медицина. Журналістика. Знання. Розвиток.">
<meta property="og:type" content="website">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root {
  --bg: #090b10;
  --bg2: #0e121a;
  --card: #131923;
  --card2: #19212c;
  --text: #f3f0e9;
  --muted: #a3aab6;
  --gold: #d6b77c;
  --gold2: #f0d9a9;
  --line: rgba(255,255,255,.10);
  --max: 1200px;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 85px;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: "DM Sans", sans-serif;
  line-height: 1.7;
  overflow-x: hidden;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
}

.container {
  width: min(var(--max), calc(100% - 48px));
  margin: auto;
}

.gold {
  color: var(--gold);
}

.eyebrow {
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 3px;
  font-size: 10px;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 12px;
}

.eyebrow::before {
  content: "";
  width: 25px;
  height: 1px;
  background: var(--gold);
}

h1, h2, h3 {
  line-height: 1.15;
  font-weight: 600;
}

h1, h2 {
  font-family: "Playfair Display", serif;
}

section {
  padding: 115px 0;
  position: relative;
}

.section-heading {
  max-width: 760px;
  margin-bottom: 55px;
}

.section-heading h2 {
  font-size: clamp(38px, 5vw, 62px);
  letter-spacing: -1.8px;
  margin-top: 20px;
}

.section-heading p {
  color: var(--muted);
  margin-top: 22px;
  max-width: 620px;
  font-size: 14px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 15px 24px;
  font-size: 12px;
  font-weight: 700;
  border-radius: 3px;
  transition: .3s;
  cursor: pointer;
}

.btn-primary {
  color: #101116;
  background: var(--gold);
}

.btn-primary:hover {
  background: var(--gold2);
  transform: translateY(-3px);
}

.btn-outline {
  border: 1px solid rgba(255,255,255,.22);
}

.btn-outline:hover {
  border-color: var(--gold);
  color: var(--gold);
}

/* HEADER */

header {
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 1000;
  border-bottom: 1px solid transparent;
  transition: .3s;
}

header.scrolled {
  background: rgba(9,11,16,.93);
  backdrop-filter: blur(18px);
  border-color: var(--line);
}

.nav {
  height: 82px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-size: 15px;
  font-weight: 800;
  letter-spacing: 2px;
}

.logo span {
  color: var(--gold);
}

.nav-links {
  display: flex;
  gap: 25px;
  align-items: center;
}

.nav-links a {
  font-size: 11px;
  color: #c2c7d0;
  transition: .25s;
}

.nav-links a:hover {
  color: var(--gold);
}

.nav-actions {
  display: flex;
  gap: 10px;
}

.lang-btn, .menu-btn {
  background: transparent;
  color: var(--text);
  border: 1px solid var(--line);
  padding: 8px 13px;
  cursor: pointer;
  border-radius: 30px;
  font-size: 11px;
}

.menu-btn {
  display: none;
}

/* HERO */

.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding: 140px 0 90px;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 80% 30%, rgba(190,145,75,.15), transparent 36%),
    radial-gradient(ellipse at 5% 90%, rgba(54,77,120,.12), transparent 38%);
}

.hero::after {
  content: "YV";
  position: absolute;
  right: -50px;
  bottom: -160px;
  font-family: "Playfair Display", serif;
  font-size: clamp(300px, 43vw, 600px);
  color: rgba(255,255,255,.018);
  pointer-events: none;
  line-height: 1;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.2fr .8fr;
  align-items: center;
  gap: 65px;
  position: relative;
  z-index: 2;
}

.hero h1 {
  font-size: clamp(55px, 8vw, 100px);
  letter-spacing: -4px;
  margin: 28px 0;
}

.hero h1 span {
  color: var(--gold);
}

.hero-description {
  color: var(--muted);
  max-width: 550px;
  font-size: 15px;
}

.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 38px;
}

.hero-card {
  min-height: 470px;
  padding: 35px;
  background:
    linear-gradient(145deg, rgba(214,183,124,.12), transparent 50%),
    var(--card);
  border: 1px solid rgba(214,183,124,.25);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
}

.hero-card::before {
  content: "";
  position: absolute;
  width: 330px;
  height: 330px;
  border: 1px solid rgba(214,183,124,.16);
  border-radius: 50%;
  right: -130px;
  top: -100px;
}

.monogram {
  font-family: "Playfair Display", serif;
  font-size: 150px;
  text-align: center;
  color: rgba(214,183,124,.75);
  margin: auto;
  line-height: 1;
}

.hero-card-bottom {
  border-top: 1px solid var(--line);
  padding-top: 20px;
}

.hero-card-bottom strong {
  display: block;
  font-size: 18px;
}

.hero-card-bottom span {
  font-size: 11px;
  color: var(--muted);
}

/* MARQUEE */

.marquee {
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  overflow: hidden;
  padding: 23px 0;
  background: var(--bg2);
}

.marquee-inner {
  display: flex;
  width: max-content;
  animation: move 35s linear infinite;
}

.marquee-inner span {
  color: var(--muted);
  padding: 0 45px;
  font-size: 11px;
  letter-spacing: 3px;
  text-transform: uppercase;
}

.marquee-inner b {
  color: var(--gold);
  margin-right: 12px;
}

@keyframes move {
  to { transform: translateX(-50%); }
}

/* ABOUT */

.about-grid {
  display: grid;
  grid-template-columns: .8fr 1.2fr;
  gap: 80px;
}

.about-visual {
  min-height: 440px;
  padding: 35px;
  border: 1px solid var(--line);
  background:
    linear-gradient(140deg, rgba(214,183,124,.15), transparent),
    var(--card);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.about-visual strong {
  font-family: "Playfair Display", serif;
  font-size: 115px;
  color: var(--gold);
  line-height: 1;
}

.about-visual p {
  color: var(--muted);
  font-size: 13px;
  max-width: 250px;
}

.about-content h3 {
  font-family: "Playfair Display", serif;
  font-size: 32px;
  margin-bottom: 25px;
}

.about-content p {
  color: var(--muted);
  font-size: 14px;
  margin-bottom: 18px;
}

.about-facts {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-top: 38px;
}

.fact {
  border-top: 1px solid var(--line);
  padding-top: 15px;
  font-size: 13px;
}

.fact span {
  display: block;
  color: var(--gold);
  font-size: 10px;
  letter-spacing: 2px;
  margin-bottom: 7px;
}

/* EDUCATION */

.education {
  background: var(--bg2);
}

.education-card {
  padding: 45px;
  background: var(--card);
  border: 1px solid var(--line);
  display: grid;
  grid-template-columns: 100px 1fr;
  gap: 35px;
}

.education-symbol {
  font-family: "Playfair Display", serif;
  font-size: 75px;
  color: var(--gold);
  line-height: 1;
}

.education-card h3 {
  font-size: 25px;
  margin: 10px 0 15px;
}

.education-card p {
  color: var(--muted);
  font-size: 14px;
}

.education-tag {
  display: inline-block;
  color: var(--gold);
  border: 1px solid rgba(214,183,124,.3);
  padding: 7px 12px;
  margin-top: 20px;
  font-size: 10px;
  letter-spacing: 1px;
}

/* FIELDS */

.fields-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 18px;
}

.field-card {
  padding: 35px;
  min-height: 300px;
  background: var(--card);
  border: 1px solid var(--line);
  transition: .35s;
}

.field-card:hover {
  transform: translateY(-7px);
  border-color: rgba(214,183,124,.55);
}

.field-number {
  font-family: "Playfair Display", serif;
  font-size: 34px;
  color: var(--gold);
}

.field-card h3 {
  font-size: 23px;
  margin: 30px 0 15px;
}

.field-card p {
  color: var(--muted);
  font-size: 13px;
}

/* JOURNALISM */

.journalism {
  background: var(--bg2);
}

.journalism-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 25px;
}

.journalism-panel {
  padding: 38px;
  background: var(--card);
  border: 1px solid var(--line);
}

.journalism-panel h3 {
  font-family: "Playfair Display", serif;
  font-size: 27px;
  margin: 25px 0 15px;
}

.journalism-panel p {
  color: var(--muted);
  font-size: 13px;
}

.media-name {
  font-size: 25px;
  font-weight: 800;
  letter-spacing: 1px;
  color: var(--gold);
}

.media-link {
  display: inline-block;
  margin-top: 25px;
  color: var(--gold);
  font-size: 13px;
  border-bottom: 1px solid rgba(214,183,124,.5);
  padding-bottom: 5px;
}

/* PUBLICATIONS */

.publication-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.publication {
  min-height: 300px;
  padding: 35px;
  display: flex;
  flex-direction: column;
  background: var(--card);
  border: 1px solid var(--line);
  transition: .3s;
}

.publication:hover {
  transform: translateY(-5px);
  border-color: var(--gold);
}

.publication-label {
  font-size: 10px;
  letter-spacing: 2px;
  color: var(--gold);
}

.publication h3 {
  font-family: "Playfair Display", serif;
  font-size: 27px;
  margin: 25px 0 15px;
}

.publication p {
  color: var(--muted);
  font-size: 13px;
}

.publication-link {
  color: var(--gold);
  margin-top: auto;
  padding-top: 25px;
  font-size: 13px;
}

/* TIMELINE */

.timeline-section {
  background: var(--bg2);
}

.timeline {
  max-width: 850px;
  border-left: 1px solid rgba(214,183,124,.5);
  margin-left: 10px;
}

.timeline-item {
  padding: 0 0 48px 40px;
  position: relative;
}

.timeline-item::before {
  content: "";
  width: 9px;
  height: 9px;
  position: absolute;
  left: -5px;
  top: 8px;
  background: var(--gold);
  border-radius: 50%;
}

.timeline-item span {
  color: var(--gold);
  font-size: 10px;
  letter-spacing: 2px;
}

.timeline-item h3 {
  font-size: 23px;
  margin: 10px 0;
}

.timeline-item p {
  color: var(--muted);
  font-size: 13px;
  max-width: 600px;
}

/* PRINCIPLES */

.principles-grid {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 15px;
}

.principle {
  background: var(--card);
  border-top: 1px solid var(--gold);
  padding: 28px 22px;
}

.principle h3 {
  font-size: 17px;
  margin-bottom: 12px;
}

.principle p {
  color: var(--muted);
  font-size: 12px;
}

/* TOPICS */

.topics {
  background: var(--bg2);
}

.topic-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.topic {
  border: 1px solid var(--line);
  color: var(--muted);
  padding: 13px 20px;
  font-size: 12px;
  transition: .25s;
}

.topic:hover {
  color: var(--gold);
  border-color: var(--gold);
}

/* CONTACT */

.contact {
  text-align: center;
  background:
    radial-gradient(ellipse at 50% 100%, rgba(214,183,124,.14), transparent 55%),
    var(--bg2);
}

.contact .section-heading {
  margin-left: auto;
  margin-right: auto;
}

.contact .section-heading p {
  margin-left: auto;
  margin-right: auto;
}

.contact h2 {
  font-size: clamp(42px,6vw,75px);
}

.contact-buttons {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 15px;
  margin-top: 35px;
}

.contact-note {
  color: var(--muted);
  font-size: 11px;
  margin-top: 30px;
}

/* FOOTER */

footer {
  border-top: 1px solid var(--line);
  padding: 35px 0;
}

.footer-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
}

.footer-inner p {
  color: var(--muted);
  font-size: 11px;
}

.footer-logo {
  font-weight: 800;
  letter-spacing: 2px;
}

.footer-logo span {
  color: var(--gold);
}

/* SCROLL ANIMATION */

.reveal {
  opacity: 0;
  transform: translateY(25px);
  transition: opacity .8s ease, transform .8s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

.back-top {
  position: fixed;
  bottom: 25px;
  right: 25px;
  width: 45px;
  height: 45px;
  border: 0;
  border-radius: 50%;
  background: var(--gold);
  color: #111;
  cursor: pointer;
  opacity: 0;
  pointer-events: none;
  transition: .3s;
  z-index: 500;
}

.back-top.show {
  opacity: 1;
  pointer-events: auto;
}

/* RESPONSIVE */

@media(max-width:950px) {
  .hero-grid, .about-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .fields-grid {
    grid-template-columns: 1fr 1fr;
  }

  .principles-grid {
    grid-template-columns: 1fr 1fr;
  }

  .nav-links {
    gap: 13px;
  }
}

@media(max-width:650px) {
  .container {
    width: calc(100% - 36px);
  }

  section {
    padding: 80px 0;
  }

  .nav {
    height: 70px;
  }

  .menu-btn {
    display: block;
  }

  .nav-links {
    display: none;
    position: absolute;
    top: 70px;
    left: 0;
    width: 100%;
    padding: 25px;
    background: #10151e;
    border-bottom: 1px solid var(--line);
    flex-direction: column;
    align-items: flex-start;
  }

  .nav-links.open {
    display: flex;
  }

  .hero {
    min-height: auto;
    padding: 140px 0 70px;
  }

  .hero h1 {
    font-size: 57px;
  }

  .hero-card {
    min-height: 300px;
  }

  .monogram {
    font-size: 110px;
  }

  .fields-grid,
  .publication-grid,
  .journalism-grid,
  .principles-grid {
    grid-template-columns: 1fr;
  }

  .education-card {
    grid-template-columns: 1fr;
    padding: 28px;
  }

  .education-symbol {
    font-size: 55px;
  }

  .about-facts {
    grid-template-columns: 1fr;
  }

  .footer-inner {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media(prefers-reduced-motion:reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    animation: none !important;
    transition: none !important;
  }

  .reveal {
    opacity: 1;
    transform: none;
  }
}
</style>
</head>

